<UserControl x:Class="AbasteceCRAS.MVVM.Views.EstoqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AbasteceCRAS.MVVM.Views"
             xmlns:services="clr-namespace:AbasteceCRAS.Services"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>
        
        
        
        <!-- Estilo para os labels (Item, Tipo, etc) -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>



            <Style TargetType="RadioButton">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="BorderBrush" Value="Gray"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="FontSize" Value="14"/>
                

            <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#DDD"/>
                                </Trigger>

                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="Black"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


        <!-- Estilo para os botões de Alternância (Entrada/Saída) -->
        <Style x:Key="ToggleButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
             BorderBrush="{TemplateBinding BorderBrush}" 
             BorderThickness="1" 
             CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#888888" CornerRadius="4" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="9.9*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.8*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0" Grid.Column="0" Margin="10"
                Width="50" Height="30" Style="{StaticResource BotaoRetorno}"
                Command="{Binding VoltarHome}"/>


        <Grid Grid.Column="1" Grid.Row="1"  Background="White">
            <!-- Este container centraliza todo o conteúdo na tela -->
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="1200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="450"/>
                    <ColumnDefinition Width="650"/>
                </Grid.ColumnDefinitions>

                <!-- COLUNA DA ESQUERDA: FORMULÁRIO -->
                <StackPanel Grid.Column="0" Margin="20">
                    <TextBlock Text="Gerenciamento de Estoque" FontSize="26" FontWeight="Bold" Margin="0,0,0,25"/>

                    <Border BorderBrush="#EEE" BorderThickness="1.5" Padding="25" CornerRadius="15">
                        <StackPanel>
                            <TextBlock Text="Nova Movimentação" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                            <TextBlock Text="Qual ação irá fazer?" Style="{StaticResource FieldLabelStyle}"/>
                            <UniformGrid Columns="3" Margin="0,0,0,20">
                                <RadioButton Content="Entrada" IsChecked="{Binding IsEntrada}"/>
                                <RadioButton Content="Saída" IsChecked="{Binding IsSaida}"/>
                                <RadioButton Content="Trocar Deposito" IsChecked="{Binding IsTrocaDeposito}"/>
                            </UniformGrid>

                            <Grid>


                                <Grid Visibility="{Binding EntradaOperacaoVisibility}">

                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Item:" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox Grid.Row="1" Margin="0,0,0,15" ItemsSource="{Binding ListaItens}" DisplayMemberPath="NomeItem" SelectedItem="{Binding ItemSelecionado}"/>

                                    <Separator Grid.Row="2" Visibility="Hidden"/>

                                    <TextBlock Grid.Row="3" Text="Tipo:" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox Grid.Row="4" Margin="0,0,0,15" ItemsSource="{Binding ListaTipos}" DisplayMemberPath="NomeTipo" SelectedItem="{Binding TipoSelecionado}"/>

                                    <Separator Grid.Row="5" Visibility="Hidden"/>

                                    <Grid Grid.Row="6" Visibility="{Binding ValidadeVisibility}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Validade:" Style="{StaticResource FieldLabelStyle}"/>
                                        <DatePicker Grid.Row="1" Margin="0,0,0,15" SelectedDate="{Binding DataSelecionada}"/>
                                    </Grid>

                                    <Separator Grid.Row="7" Visibility="Hidden"/>

                                    <TextBlock Grid.Row="8" Text="Quantidade:" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox  Grid.Row="9" Text="{Binding ValorQuantidade}" Height="45" Background="#F0F4F8" BorderThickness="0" Margin="0,0,0,25" 
                                             VerticalContentAlignment="Center" Padding="15,0" FontWeight="SemiBold"/>

                                </Grid>


                                <Grid Visibility="{Binding SaidaOperacaoVisibility}">
                                    
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Item:" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox Grid.Row="1" Margin="0,0,0,15" ItemsSource="{Binding ListaItens}" DisplayMemberPath="NomeItem" SelectedItem="{Binding ItemSelecionado}"/>

                                    <Separator Grid.Row="2" Visibility="Hidden"/>

                                    <TextBlock Grid.Row="3" Text="Tipo:" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox Grid.Row="4" Margin="0,0,0,15" ItemsSource="{Binding ListaTipos}" DisplayMemberPath="NomeTipo" SelectedItem="{Binding TipoSelecionado}"/>

                                    <Separator Grid.Row="5" Visibility="Hidden"/>

                                    <Grid Grid.Row="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Remessa:" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox Grid.Row="1" Margin="0,0,0,15" ItemsSource="{Binding ListaRemessas}" DisplayMemberPath="DataRecebimento" SelectedItem="{Binding RemessaSelecionada}"/>
                                    </Grid>

                                    <Separator Grid.Row="7" Visibility="Hidden"/>

                                    <TextBlock Grid.Row="8" Text="Quantidade:" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox  Grid.Row="9" Text="{Binding ValorQuantidade}" Height="45" Background="#F0F4F8" BorderThickness="0" Margin="0,0,0,25" 
         VerticalContentAlignment="Center" Padding="15,0" FontWeight="SemiBold"/>

                                </Grid>

                                <Grid Visibility="{Binding DepositoVisibility}"> 
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Item:" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox Grid.Row="1" Margin="0,0,0,15" ItemsSource="{Binding ListaItens}" DisplayMemberPath="NomeItem" SelectedItem="{Binding ItemSelecionado}"/>

                                    <Separator Grid.Row="2" Visibility="Hidden"/>

                                    <TextBlock Grid.Row="3" Text="Tipo:" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox Grid.Row="4" Margin="0,0,0,15" ItemsSource="{Binding ListaTipos}" DisplayMemberPath="NomeTipo" SelectedItem="{Binding TipoSelecionado}"/>

                                    <Separator Grid.Row="5" Visibility="Hidden"/>

                                    <TextBlock Grid.Row="6" Text="Remessa:" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox Grid.Row="7" Margin="0,0,0,15" ItemsSource="{Binding ListaRemessas}" DisplayMemberPath="DataRecebimento" SelectedItem="{Binding TipoSelecionado}"/>
                                    
                                    <Separator Grid.Row="8" Visibility="Hidden"/>
                                    
                                    <TextBlock Grid.Row="9" Text="Local:" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox Grid.Row="10" Margin="0,0,0,15" ItemsSource="{Binding ListaLocais}" SelectedItem="{Binding LocalSelecionado}"/>
                                </Grid>



                                </Grid>

                            <Button Content="Confirmar" Background="Black" Foreground="White" Height="48" FontWeight="Bold" Cursor="Hand"
                                    Command="{Binding BtnConfirmarOperacao}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="1" Margin="20">
                    <Border BorderBrush="#EEE" BorderThickness="1.5" CornerRadius="15" Padding="25" MinHeight="500">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="7*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="Estoque Atual" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ComboBox Width="150" HorizontalAlignment="Right" Height="30" SelectedIndex="0">
                                    <ComboBoxItem Content="Estoque Atual"/>
                                </ComboBox>
                            </Grid>


<!-- 
Aqui Começa a ListBox que externa mostra os cards
    PS: Estou me perdendo com tanta coisa.
-->
                            <ListBox Grid.Row="1"  ItemsSource="{Binding Source={x:Static services:DadosService.Instance}, Path=ListaProduto}"
                                      HorizontalContentAlignment="Stretch" 
                                      BorderThickness="0" 
                                      Background="Transparent"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="False"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="10,8" 
                        Background="White" 
                        CornerRadius="15" 
                        Padding="20"
                        BorderBrush="#F0F0F0"
                        BorderThickness="1">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.1" Color="Black"/>
                                            </Border.Effect>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0" 
Command="{Binding DataContext.DiminuirLista, RelativeSource={RelativeSource AncestorType=ListBox}}"
CommandParameter="{Binding}"
Width="32" Height="32" 
Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="#F8F9FA"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#E9ECEF"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>

                                                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="#495057">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="▶"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Expandido}" Value="True">
                                                                            <Setter Property="Text" Value="▼"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>

                                                    <TextBlock Grid.Column="1" 
                                       Text="{Binding NomeItem}" 
                                       FontSize="17" 
                                       FontWeight="Bold" 
                                       VerticalAlignment="Center" 
                                       Margin="15,0"
                                       Foreground="#212529"/>

                                                    <Border Grid.Column="2" Background="#E3F2FD" CornerRadius="8" Padding="10,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📦 " FontSize="10" VerticalAlignment="Center"/>
                                                            <TextBlock Text="ESTOQUE" FontSize="10" FontWeight="Black" Foreground="#1976D2"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                
                                                
                                                <!-- Lista dos tipos de itens -->
                                                
                                                
                                                <ItemsControl Grid.Row="1" 
                                                              ItemsSource="{Binding TipoDeItems}" 
                                                              Margin="47,15,0,0">
                                                    
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Expandido}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>

                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#F8F9FA" BorderThickness="0,0,0,1" Padding="0,10">

                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="3*"/>
                                                                            <ColumnDefinition Width="auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Text="{Binding NomeTipo}" 
                                                       Foreground="#6C757D" 
                                                       FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>


                                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">

                                                                            <TextBlock Text="{Binding QuantidadeTipoEstoque}" 
                                                            FontWeight="Bold" 
                                                            Foreground="#28a745" 
                                                            FontSize="14"/>

                                                                            <TextBlock Text=" un" FontSize="12" Foreground="#ADB5BD" VerticalAlignment="Bottom" Margin="2,0,0,0"/>
                                                                        </StackPanel>
                                                                    </Grid>


                                                                    <ItemsControl ItemsSource="{Binding Remessas}" Margin="20,5,0,0">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="#FAFAFA" CornerRadius="4" Padding="10,6" Margin="0,3" BorderBrush="#EEEEEE" BorderThickness="1">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>

                                                                                        <!-- Data de Cadastro / Recebimento -->
                                                                                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                                                            <TextBlock Text="Cadastrado em: " FontSize="12" Foreground="#888888"/>
                                                                                            <TextBlock Text="{Binding DataRecebimento, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="12" Foreground="#555555" FontWeight="Medium"/>
                                                                                        </StackPanel>
                                                                                        <!-- Data de Validade (Fica invisível automaticamente se for nula) -->
                                                                                        <TextBlock Grid.Column="1" Text="{Binding DataValidade, StringFormat='Validade: {0:dd/MM/yyyy}', TargetNullValue=''}" 
                                                                                                   FontSize="12" Foreground="#C62828" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        <!-- Quantidade da Remessa -->
                                                                                        <TextBlock Grid.Column="2" Text="{Binding Quantidade, StringFormat='{}{0} un'}" 
                                                                                                   FontSize="12" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center"/>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>


                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>


    </Grid>

    

</UserControl>
