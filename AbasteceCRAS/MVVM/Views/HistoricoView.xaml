<UserControl x:Class="AbasteceCRAS.MVVM.Views.HistoricoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AbasteceCRAS.MVVM.Views"
             xmlns:services="clr-namespace:AbasteceCRAS.Services"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#F5F7FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Width="50"
                        Height="35"
                        Style="{StaticResource BotaoRetorno}"
                        Command="{Binding RetornarParaHome}"/>

                <TextBlock Grid.Column="1"
                           Margin="20,0"
                           Text="Histórico de Movimentações"
                           VerticalAlignment="Center"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"/>

            </Grid>

        </Border>

        <!-- CONTEÚDO -->
        <Grid Grid.Row="1" Margin="15">

            <Border Background="White"
                    CornerRadius="15"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="15">

                <DataGrid x:Name="dgHistorico"
                          ItemsSource="{Binding Source={x:Static services:DadosService.Instance}, Path=ListaHistorico}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          IsReadOnly="True"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F3F4F6"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="55">

                    <!-- ESTILO DOS CABEÇALHOS -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">

                            <Setter Property="Background" Value="#F9FAFB"/>
                            <Setter Property="Foreground" Value="#374151"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Padding" Value="15,10"/>
                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>

                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- ESTILO DAS LINHAS -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">

                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#111827"/>

                            <Style.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DBEAFE"/>
                                    <Setter Property="Foreground" Value="#111827"/>
                                </Trigger>

                            </Style.Triggers>

                        </Style>
                    </DataGrid.RowStyle>

                    <!-- ESTILO DAS CÉLULAS -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">

                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Data/Hora"
                                            Width="1.5*"
                                            FontSize="14"
                                            Binding="{Binding DataDaOcorrencia}"/>

                        <DataGridTextColumn Header="Responsável"
                                            Width="*"
                                            FontSize="14"
                                            Binding="{Binding Responsavel}"/>

                        <DataGridTemplateColumn Header="Tipo"
                                                Width="*">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Border Padding="10,4"
                                            CornerRadius="15"
                                            HorizontalAlignment="Left"
                                            Background="{Binding CorTipo}">

                                        <TextBlock Text="{Binding Ocorrencia}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"/>

                                    </Border>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

    </Grid>

</UserControl>