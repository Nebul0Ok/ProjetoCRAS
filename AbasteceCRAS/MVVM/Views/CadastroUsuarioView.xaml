<UserControl x:Class="AbasteceCRAS.MVVM.Views.CadastroUsuarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AbasteceCRAS.MVVM.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="9*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>

            <Button Command="{Binding RetornarHome}" Style="{StaticResource BotaoRetorno}"/>



            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="Histórico de Movimentações"
                       FontFamily="Roboto" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <Border Grid.Column="1" Grid.Row="1"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    Margin="20" BorderBrush="Gray" 
                    BorderThickness="2" CornerRadius="20"
                    >

                <StackPanel Margin="20">
                    <TextBlock Text="Nome:"/>
                    <TextBox Text="{Binding TextNome}"/>
                    <Separator Margin="20" Visibility="Hidden"/>
                    
                    <TextBlock Text="E-Mail:"/>
                    <TextBox Text="{Binding TextEmail}"/>
                    <Separator Margin="20" Visibility="Hidden"/>

                    <TextBlock Text="Senha:"/>
                    <TextBox Text="{Binding TextSenha}"/>
                    <Separator Margin="20" Visibility="Hidden"/>

                    <Button Content="Confirmar"
                            Command="{Binding ConfirmarCadastro}"/>
                </StackPanel>
                
            </Border>

        </Grid>
    </Grid>
</UserControl>
