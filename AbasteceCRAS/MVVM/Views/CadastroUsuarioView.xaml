<UserControl x:Class="AbasteceCRAS.MVVM.Views.CadastroUsuarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AbasteceCRAS.MVVM.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0" Grid.Column="0" 
                Command="{Binding RetornarHome}" 
                Style="{StaticResource BotaoRetorno}"
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="0" Grid.Column="1"
                   Text="Cadastro de Usuário"
                   FontFamily="Roboto" FontSize="22" FontWeight="Bold" Foreground="#333333"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="10,0,0,0"/>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Width="450" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                BorderBrush="#DCDCDC" 
                BorderThickness="1.5" 
                CornerRadius="15"
                Background="#F9F9F9"
                Padding="30,25,30,25"
                Margin="0,0,0,50">

            <StackPanel>
                <TextBlock Text="Nome" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,5"/>
                <TextBox Text="{Binding TextNome, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="8,6" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="E-mail" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,5"/>
                <TextBox Text="{Binding TextEmail, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="8,6" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Senha" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,5"/>
                
                <TextBox Text="{Binding TextSenha, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="8,6" FontSize="14" Margin="0,0,0,25"/>

                <Button Content="Confirmar"
                        Command="{Binding ConfirmarCadastro}"
                        Padding="0,10" 
                        FontSize="15" 
                        FontWeight="Bold"
                        Cursor="Hand"/>
            </StackPanel>

        </Border>
    </Grid>
</UserControl>