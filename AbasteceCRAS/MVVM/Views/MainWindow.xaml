                        </Canvas>
                    </Button>

                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                        <Grid>
                            <Button x:Name="BellButton" VerticalAlignment="Center" Width="35" Height="35" Style="{StaticResource BotaoIcone}" Command="{Binding AlternarNotificacoes}">
