                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="Sair"
                               FontSize="14"
                               Foreground="#2D2D2D"
                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                </Grid>

            </Border>

            <Grid Background="#203475" Opacity="0.5"  Grid.Column="1"/>
        </Grid>


    </Grid>
</Window>
