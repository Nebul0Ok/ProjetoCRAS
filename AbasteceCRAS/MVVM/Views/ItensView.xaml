<UserControl x:Class="AbasteceCRAS.MVVM.Views.ItensView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:AbasteceCRAS.Services"
             xmlns:local="clr-namespace:AbasteceCRAS.MVVM.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">

    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Style="{StaticResource BotaoRetorno}"
                    Width="50" Height="35" FontSize="20"
                    Command="{Binding RetornarParaHome}"/>

            <TextBlock Text="Gerenciamento de Itens" Grid.Column="1"
                       VerticalAlignment="Center" Margin="10,0,0,0"
                       FontFamily="Roboto" FontSize="22" FontWeight="Bold" Foreground="#333333"/>
        </Grid>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F9F9F9" BorderBrush="#DCDCDC" BorderThickness="1.5" CornerRadius="15" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Adicionar Novo Item" FontSize="16" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,10"/>
                        <TextBlock Text="Nome do item" FontSize="11" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Padding="8,6" FontSize="14" VerticalContentAlignment="Center"
                                     Text="{Binding NomeItem, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="+ Adicionar" Style="{StaticResource Botoes}"
                                    Padding="15,0" Margin="10,0,0,0" FontWeight="Bold" Height="34"
                                    Command="{Binding AdicionarItem}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="chkPerecivel" IsChecked="{Binding IsPerecivel}" VerticalAlignment="Center"/>
                            <TextBlock Text="É perecível?" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#444444"/>
                        </StackPanel>
                    </StackPanel>
                </Border>


                <Grid Grid.Row="1" Margin="5,0,5,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Pesquisar Item:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,10,0" FontSize="13"/>
                    <TextBox Grid.Column="1" Padding="6,4" FontSize="13" VerticalContentAlignment="Center"
                             Text="{Binding NomeItemPesquisado, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>


                <ListBox Grid.Row="2" ItemsSource="{Binding ListaProduto}"
                         SelectedItem="{Binding ItemSelecionado, Mode=TwoWay}"
                         HorizontalContentAlignment="Stretch" BorderBrush="Transparent" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" BorderBrush="#DCDCDC" BorderThickness="1.5" Background="White" Margin="0,4,0,4" Padding="15,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding NomeItem}" Grid.Row="0" FontSize="18" FontWeight="Bold" Foreground="#222222"/>
                                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding QuantidadeDeTipos, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Foreground="#777373" FontWeight="Medium"/>
                                        <TextBlock Text=" tipo(s)" FontSize="13" Foreground="#777373"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Background="#F9F9F9" BorderBrush="#DCDCDC" BorderThickness="1.5" CornerRadius="15" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Tipo de Item:" FontSize="16" FontWeight="Bold" Foreground="#333333"/>
                            <TextBlock Text="{Binding ItemSelecionado.NomeItem}" FontSize="16" FontWeight="Bold" Margin="8,0,0,0" Foreground="#2B5B84"/>
                        </StackPanel>

                        <TextBlock Text="Adicionar especificação (ex: Branco 1KG, Integral)" FontSize="11" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                        <TextBox Padding="8,6" FontSize="14" Margin="0,0,10,12" VerticalContentAlignment="Center"
                                 Text="{Binding NomeDoTipo}"/>

                        <TextBlock Text="Adicionar quantidade inicial" FontSize="11" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Padding="8,6" FontSize="14" VerticalContentAlignment="Center"
                                     Text="{Binding QuantidadeTipoItem}"/>
                            <Button Grid.Column="1" Content="+ Adicionar" Style="{StaticResource Botoes}"
                                    Padding="15,0" Margin="10,0,0,0" FontWeight="Bold" Height="34"
                                    Command="{Binding AdicionarTipo}"/>
                        </Grid>
                        <!--
                        <ComboBox ItemsSource="{Binding Source={x:Static services:DadosService.Instance}, Path=ListaDeposito}">                           
                        </ComboBox>
                        -->
                        <ItemsControl/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="5,0,5,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Filtrar Subtipos:" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,10,0" FontSize="13"/>
                    <TextBox Grid.Column="1" Padding="6,4" FontSize="13" VerticalContentAlignment="Center"
                             Text="{Binding NomeTipoPesquisado, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

<ListBox Grid.Row="2" ItemsSource="{Binding ListaTipo}"
                         BorderBrush="Transparent" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" BorderBrush="#DCDCDC" BorderThickness="1.5" Background="White" Margin="0,4,0,4" Padding="15,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding NomeTipo}" FontSize="15" FontWeight="Bold" Foreground="#333333"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Quantidade: " FontSize="13" Foreground="#666666"/>
                                        <TextBlock Text="{Binding QuantidadeTipoEstoque}" FontSize="13" FontWeight="Bold" Foreground="#222222"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
