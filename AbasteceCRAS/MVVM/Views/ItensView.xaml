<UserControl x:Class="AbasteceCRAS.MVVM.Views.ItensView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:AbasteceCRAS.Services"
             xmlns:local="clr-namespace:AbasteceCRAS.MVVM.Views"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#F5F7FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource BotaoRetorno}"
                        Width="50"
                        Height="35"
                        FontSize="20"
                        Command="{Binding RetornarParaHome}"/>

                <TextBlock Grid.Column="1"
                           Text="Gerenciamento de Itens"
                           VerticalAlignment="Center"
                           Margin="20,0"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"/>
            </Grid>
        </Border>

        <!-- CONTEÚDO -->
        <Grid Grid.Row="1" Margin="15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- LADO ESQUERDO -->
            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- CARD ADICIONAR ITEM -->
                <Border Grid.Row="0"
                        Margin="5"
                        Padding="15"
                        Background="White"
                        CornerRadius="15"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="Adicionar Novo Item"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>

                        <TextBlock Text="Nome do Item"
                                   Margin="0,10,0,5"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#6B7280"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Height="35"
                                     Margin="0,0,10,0"
                                     Text="{Binding NomeItem, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Grid.Column="1"
                                    Content="+ Adicionar"
                                    Style="{StaticResource Botoes}"
                                    Command="{Binding AdicionarItem}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,12,0,0">

                            <CheckBox IsChecked="{Binding IsPerecivel}"/>

                            <TextBlock Text="É perecível?"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- PESQUISA -->
                <Border Grid.Row="1"
                        Margin="5"
                        Padding="10"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Pesquisar:"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>

                        <TextBox Grid.Column="1"
                                 Height="32"
                                 Margin="10,0,0,0"
                                 Text="{Binding NomeItemPesquisado, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                </Border>

                <!-- LISTA DE ITENS -->
                <ListBox Grid.Row="2"
                         Margin="5"
                         ItemsSource="{Binding ListaProduto}"
                         SelectedItem="{Binding ItemSelecionado, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Margin="0,0,0,10"
                                    Padding="12"
                                    Background="White"
                                    CornerRadius="12"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="{Binding NomeItem}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,5,0,0">

                                            <TextBlock Text="{Binding QuantidadeDeTipos}"
                                                       Foreground="#6B7280"/>

                                            <TextBlock Text=" tipo(s)"
                                                       Foreground="#6B7280"/>
                                        </StackPanel>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

            <!-- LADO DIREITO -->
            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- CARD TIPO -->
                <Border Grid.Row="0"
                        Margin="5"
                        Padding="15"
                        Background="White"
                        CornerRadius="15"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Tipos do Item"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding ItemSelecionado.NomeItem}"
                                       Margin="15,0,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#2563EB"/>

                        </StackPanel>

                        <TextBlock Text="Adicionar Tipo"
                                   Margin="0,15,0,5"
                                   FontWeight="Bold"
                                   Foreground="#6B7280"/>

                        <TextBox Height="35"
                                 Text="{Binding NomeDoTipo}"/>

                        <Button Content="+ Adicionar"
                                Margin="0,15,0,0"
                                Width="130"
                                HorizontalAlignment="Right"
                                Style="{StaticResource Botoes}"
                                Command="{Binding AdicionarTipo}"/>

                    </StackPanel>

                </Border>

                <!-- PESQUISA -->
                <Border Grid.Row="1"
                        Margin="5"
                        Padding="10"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Pesquisar Tipos:"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                                 Height="32"
                                 Margin="10,0,0,0"
                                 Text="{Binding NomeTipoPesquisado, UpdateSourceTrigger=PropertyChanged}"/>

                    </Grid>

                </Border>

                <!-- LISTA TIPOS -->
                <ListBox Grid.Row="2"
                         Margin="5"
                         ItemsSource="{Binding ListaTipo}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Border Margin="0,0,0,10"
                                    Padding="12"
                                    Background="White"
                                    CornerRadius="12"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="Nome:"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"/>

                                    <TextBlock Text="{Binding NomeTipo}"
                                               Margin="8,0,0,0"
                                               Foreground="#111827"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Grid>

    </Grid>

</UserControl>